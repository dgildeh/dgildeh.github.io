---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Sidebar from '../../../../components/Sidebar.astro';
import { getPosts, postDate, SITE, tagSlug, type Post } from '../../../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const [, year, month, day, slug] = post.data.permalink.split('/');
    return {
      params: { year, month, day, slug },
      props: { post, newer: posts[i - 1], older: posts[i + 1] },
    };
  });
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const date = postDate(post);
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedTime={post.data.date.toISOString()}
>
  <div class="layout-sidebar">
    <article class="content" data-pagefind-body>
      <header class="entry-header">
        <h1 class="entry-title">{post.data.title}</h1>
        <div class="entry-meta">
          <time datetime={date.iso} data-pagefind-meta="date">{date.label}</time><br />
          By <a href="/about/">{SITE.author}</a>
        </div>
      </header>
      <div class="prose">
        <Content />
      </div>
      {
        post.data.tags.length > 0 && (
          <footer class="entry-footer" data-pagefind-ignore>
            <span class="tags">
              {post.data.tags.map((t) => (
                <a href={`/tag/${tagSlug(t)}/`} rel="tag">
                  {t}
                </a>
              ))}
            </span>
          </footer>
        )
      }
      <nav class="post-nav" aria-label="Post" data-pagefind-ignore>
        {older && <a class="prev" href={older.data.permalink}>&larr; {older.data.title}</a>}
        {newer && <a class="next" href={newer.data.permalink}>{newer.data.title} &rarr;</a>}
      </nav>
    </article>
    <Sidebar />
  </div>
</Base>
