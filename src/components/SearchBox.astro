---
interface Props {
  rss?: boolean;
}
const { rss = false } = Astro.props;
---

<div class="index-box">
  <form class="search-form" role="search" method="get" action="/search/">
    <label class="screen-reader-text" for="search-q">Search site</label>
    <input id="search-q" type="search" name="q" placeholder="Search site" />
    <button type="submit" aria-label="Search">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="6.5" cy="6.5" r="5" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="M10.2 10.2 15 15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </form>
  {
    rss && (
      <a class="rss-link" href="/rss.xml" title="RSS feed">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <circle cx="2.5" cy="13.5" r="2.5" />
          <path d="M0 5.5v3a7.5 7.5 0 0 1 7.5 7.5h3A10.5 10.5 0 0 0 0 5.5zM0 0v3a13 13 0 0 1 13 13h3A16 16 0 0 0 0 0z" />
        </svg>
        <span class="screen-reader-text">RSS feed</span>
      </a>
    )
  }
</div>
