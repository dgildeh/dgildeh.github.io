---
import '../styles/global.css';
import { NAV, SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 'article' for blog posts. */
  type?: 'website' | 'article';
  publishedTime?: string;
}

const { title, description = SITE.tagline, image, type = 'website', publishedTime } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} | ${SITE.tagline.split('.')[0]}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:creator" content="@dgildeh" />
    {
      import.meta.env.PROD && SITE.googleAnalyticsId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.googleAnalyticsId}`} />
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ${JSON.stringify(SITE.googleAnalyticsId)});`}
          />
        </>
      )
    }
  </head>
  <body>
    <div class="body-content">
      <header class="site-header">
        <div class="branding">
          <p class="site-title"><a href="/" title="Home">{SITE.title}</a></p>
          <p class="tagline">{SITE.tagline}</p>
        </div>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>
      <main id="container">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      &copy; {new Date().getFullYear()} {SITE.author} · <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>
